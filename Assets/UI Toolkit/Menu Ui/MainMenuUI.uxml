    <ui:VisualElement style="flex-grow: 1; font-size: 20px; justify-content: center; align-items: center; align-self: center; padding-top: 0; padding-right: 0; flex-direction: column; width: 100%; height: 100%; aspect-ratio: 1.777778;">
